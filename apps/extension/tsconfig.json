{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src", "vite.config.ts"],
  "references": [{ "path": "../../packages/shared" }]
}
