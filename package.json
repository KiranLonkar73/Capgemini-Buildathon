{
  "name": "complylens-policy-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0 --force",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:extension": "vite build --config apps/extension/vite.config.ts",
    "build": "npm run build:web && npm run build:extension",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.171.0",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2"
  }
}
